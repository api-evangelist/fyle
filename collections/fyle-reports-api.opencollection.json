{
  "opencollection": "1.0.0",
  "info": {
    "name": "Fyle Platform Advances Reports API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Reports",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List reports (admin)",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.fylehq.com/platform/v1/admin/reports",
            "params": [
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "Number of records to skip for pagination (mandatory)."
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Maximum number of records to return per page (mandatory)."
              },
              {
                "name": "order",
                "value": "",
                "type": "query",
                "description": "Sort order, e.g. `created_at.desc` or `updated_at.asc` (mandatory)."
              }
            ]
          },
          "docs": "Lists expense reports in the organization with filtering and pagination."
        },
        {
          "info": {
            "name": "Create or update a report (admin)",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.fylehq.com/platform/v1/admin/reports",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates or updates an expense report."
        },
        {
          "info": {
            "name": "Bulk mark reports as paid",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.fylehq.com/platform/v1/admin/reports/mark_paid/bulk",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Marks multiple reports as paid once they have been reimbursed outside Fyle."
        },
        {
          "info": {
            "name": "List my reports (spender)",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.fylehq.com/platform/v1/spender/reports",
            "params": [
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "Number of records to skip for pagination (mandatory)."
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Maximum number of records to return per page (mandatory)."
              },
              {
                "name": "order",
                "value": "",
                "type": "query",
                "description": "Sort order, e.g. `created_at.desc` or `updated_at.asc` (mandatory)."
              }
            ]
          },
          "docs": "Lists the signed-in spender's own reports."
        },
        {
          "info": {
            "name": "Create a report (spender)",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.fylehq.com/platform/v1/spender/reports",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a report for the signed-in spender."
        },
        {
          "info": {
            "name": "Add expenses to a report",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.fylehq.com/platform/v1/spender/reports/add_expenses",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Adds one or more expenses to an existing report."
        },
        {
          "info": {
            "name": "Submit a report",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.fylehq.com/platform/v1/spender/reports/submit",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Submits a report for approval."
        }
      ]
    }
  ],
  "bundled": true
}