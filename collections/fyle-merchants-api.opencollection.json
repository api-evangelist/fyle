{
  "opencollection": "1.0.0",
  "info": {
    "name": "Fyle Platform Advances Merchants API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Merchants",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List merchants (spender)",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.fylehq.com/platform/v1/spender/merchants",
            "params": [
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "Number of records to skip for pagination (mandatory)."
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Maximum number of records to return per page (mandatory)."
              },
              {
                "name": "order",
                "value": "",
                "type": "query",
                "description": "Sort order, e.g. `created_at.desc` or `updated_at.asc` (mandatory)."
              }
            ]
          },
          "docs": "Lists merchant/vendor values available to the signed-in spender."
        },
        {
          "info": {
            "name": "Bulk add merchants (spender)",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.fylehq.com/platform/v1/spender/merchants",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Adds new merchant values in bulk."
        }
      ]
    }
  ],
  "bundled": true
}